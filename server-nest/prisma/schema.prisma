// Prisma schema — E2E Orchestrator
// 数据库：MySQL 8
// 命名约定：snake_case 列名（@map），模型 PascalCase，DTO 显式
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =================== 枚举 ===================
// 空间成员角色：OWNER 全权 / EDITOR 编辑 / VIEWER 只读
enum SpaceRole {
  OWNER
  EDITOR
  VIEWER
}

// =================== 用户 ===================
model User {
  id        String   @id @default(cuid())
  username  String   @unique @db.VarChar(64)
  // bcrypt 哈希；不存明文
  password  String   @db.VarChar(255)
  nickname  String?  @db.VarChar(64)
  // 0=禁用 1=启用
  status    Int      @default(1) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships SpaceMember[]
  cases       Case[]
  lockedCases Case[]   @relation("CaseLock")

  @@map("users")
  @@index([username])
}

// =================== 空间 ===================
model Space {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(64)
  // 'common' = 系统默认空间，不可删除
  isDefault   Boolean  @default(false) @map("is_default")
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members    SpaceMember[]
  cases      Case[]
  schemas    FormSchema[]

  @@map("spaces")
}

// 空间成员 + 角色
model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String   @map("space_id")
  userId    String   @map("user_id")
  role      SpaceRole @default(EDITOR)
  createdAt DateTime @default(now()) @map("created_at")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@map("space_members")
  @@index([userId])
}

// =================== 用例 ===================
model Case {
  id        String   @id @default(cuid())
  spaceId   String   @map("space_id")
  // 创建人
  creatorId String   @map("creator_id")
  name      String   @db.VarChar(128)
  // 画布 schema（nodes + edges，JSON 存储）
  schema    Json
  // ---------- 编辑锁 ----------
  // 单人编辑锁：同一时间只允许一个用户进入画布编辑
  // 设计：acquireLock 原子获取；每 25s heartbeat 续期；TTL=60s 无心跳自动过期
  lockedByUserId String?   @map("locked_by_user_id")
  lockedAt       DateTime? @map("locked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  space         Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator       User  @relation(fields: [creatorId], references: [id])
  lockedByUser  User? @relation("CaseLock", fields: [lockedByUserId], references: [id])

  @@map("cases")
  @@index([spaceId])
  @@index([creatorId])
  @@index([lockedByUserId])
}

// =================== 表单设计 ===================
// 每种节点类型对应一份 schema（atoms 数组）
// 存在 space 维度：每个空间可以独立定制
model FormSchema {
  id        String   @id @default(cuid())
  spaceId   String   @map("space_id")
  // 节点类型：openPage / click / input / ...
  nodeType  String   @map("node_type") @db.VarChar(32)
  // atoms 数组
  schema    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, nodeType])
  @@map("form_schemas")
}

// =================== 审计/运行日志（可选，预留）====================
model RunLog {
  id        String   @id @default(cuid())
  caseId    String   @map("case_id")
  // pass / fail
  result    String   @db.VarChar(16)
  duration  Int
  log       Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("run_logs")
  @@index([caseId])
}
