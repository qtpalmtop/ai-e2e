# --- Database ---
# 本地 MySQL 8（与 docker-compose 默认一致）
DATABASE_URL="mysql://e2e:e2e_pwd@localhost:3306/e2e_orchestrator?schema=public&charset=utf8mb4"

# --- App ---
PORT=4000
NODE_ENV=development
# JWT 密钥：生产请改成 32 位以上随机串
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=e2e_token
# 跨域前端 origin（开发期逗号分隔多源）
CORS_ORIGIN=http://localhost:5173

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- OpenTelemetry ---
# 留空 = 仅控制台输出（开发期够用）；生产可指向 OTLP collector
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=e2e-orchestrator-nest
